# PHP 8.5 forward-compatibility gate for language-level and stub drift (see
# composer check:php85). PHPStan 2.2 stubs carry no #[Deprecated] on
# Reflection::*::setAccessible(), so the banned-call check in composer.json
# covers internal-method deprecations instead.
includes:
    - phpstan.neon.dist

parameters:
    phpVersion: 80500
